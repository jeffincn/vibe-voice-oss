<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is not sandboxed; these are hardened-runtime exceptions.
	     Keep this list minimal — every entry weakens the runtime protection. -->

	<!-- AVAudioEngine input. Without this the hardened runtime denies capture
	     before TCC is ever consulted. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- PasteService falls back to NSAppleScript to drive the frontmost app when
	     Accessibility insertion is unavailable, which is Apple Events. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
